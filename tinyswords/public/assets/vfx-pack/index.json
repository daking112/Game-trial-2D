{
  "meta": {
    "name": "Unsorted Particle/VFX Pack",
    "description": "Loose pixel-art VFX spritesheets found at the repo root in numbered 'Part N' folders (free sample downloads from an unidentified marketplace/itch.io pack, each with a 'Preview Free N.gif'). Original source/pack name is unknown - the user had no context on where these came from. Every sheet uses a confirmed 64x64 cell grid: each row (9 rows per sheet) is a distinct color/palette variant of the same effect, and columns are that effect's animation frames (frame count varies per effect). Frame dimensions here are DERIVED from verified pixel measurements (every sheet's height is exactly 9x64px with no exceptions), not guessed.",
    "basePath": "assets/vfx-pack/",
    "cellSize": {
      "width": 64,
      "height": 64
    },
    "rowsPerSheet": 9,
    "rowMeaning": "each row = one color/palette variant of the effect",
    "columnMeaning": "each column = one animation frame",
    "usage": "Not wired into any game yet. To use in Phaser: this.load.spritesheet(key, basePath + path, { frameWidth: 64, frameHeight: 64 }), then this.anims.create({ frames: this.anims.generateFrameNumbers(key, { start: row*columns, end: row*columns + columns - 1 }) }) to pick one color row.",
    "sheetCount": 126
  },
